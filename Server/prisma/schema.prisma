generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  freelancer
  client
}

enum ProjectStatus {
  active
  archived
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
}

enum SenderRole {
  freelancer
  client
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          UserRole        @default(freelancer)
  clientId      String?         @unique
  client        Client?         @relation("ClientUser", fields: [clientId], references: [id])
  freelancerClients Client[]     @relation("FreelancerClient")
  projects      Project[]
  tasks         Task[]
  workSessions  WorkSession[]
  invoices      Invoice[]
  messagesSent  Message[]       @relation("MessageSender")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Client {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation("FreelancerClient", fields: [userId], references: [id])
  clientUser        User?           @relation("ClientUser")
  name              String
  email             String?
  phone             String?
  address           String?
  defaultHourlyRate Float           @default(0)
  projects          Project[]
  invoices          Invoice[]
  messages          Message[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Project {
  id          String       @id @default(uuid())
  userId      String
  clientId    String
  user        User         @relation(fields: [userId], references: [id])
  client      Client       @relation(fields: [clientId], references: [id])
  name        String
  description String?
  deadline    DateTime?
  hourlyRate  Float?
  status      ProjectStatus @default(active)
  tasks       Task[]
  workSessions WorkSession[]
  invoices    Invoice[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Task {
  id            String       @id @default(uuid())
  userId        String
  projectId     String
  user          User         @relation(fields: [userId], references: [id])
  project       Project      @relation(fields: [projectId], references: [id])
  title         String
  description   String?
  status        TaskStatus   @default(todo)
  workSessions  WorkSession[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model WorkSession {
  id            String    @id @default(uuid())
  userId        String
  projectId     String
  taskId        String?
  invoiceId     String?
  user          User      @relation(fields: [userId], references: [id])
  project       Project   @relation(fields: [projectId], references: [id])
  task          Task?     @relation(fields: [taskId], references: [id])
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id])
  startTime     DateTime
  endTime       DateTime?
  durationMinutes Float?
  note          String?
  hourlyRate    Float?
  invoiced      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Invoice {
  id          String      @id @default(uuid())
  userId      String
  clientId    String
  projectId   String
  number      String
  issueDate   DateTime    @default(now())
  dueDate     DateTime?
  currency    String      @default("INR")
  items       Json
  subtotal    Float
  taxPercent  Float       @default(0)
  taxAmount   Float       @default(0)
  total       Float
  pdfPath     String?
  status      InvoiceStatus @default(draft)
  paidAt      DateTime?
  notes       String?
  user        User        @relation(fields: [userId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])
  project     Project     @relation(fields: [projectId], references: [id])
  workSessions WorkSession[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Message {
  id          String      @id @default(uuid())
  clientId    String
  senderId    String
  senderRole  SenderRole
  message     String
  read        Boolean     @default(false)
  client      Client      @relation(fields: [clientId], references: [id])
  sender      User        @relation("MessageSender", fields: [senderId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
